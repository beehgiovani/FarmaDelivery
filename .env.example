# API / Prisma. Use a URL do Postgres do Supabase aqui no .env local.
# Nunca commitar a URL real se ela contiver senha.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:PORT/DATABASE?schema=public&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public&sslmode=require"
API_PORT=3333
# Segredo backend para assinar sessoes da API. Trocar por valor longo e aleatorio em producao.
API_SESSION_SECRET="troque_por_um_segredo_longo_e_aleatorio"
# Opcional legado: a API tambem aceita este nome como fallback de assinatura de sessao.
# SUPABASE_JWT_SECRET="troque_por_um_segredo_longo_e_aleatorio"
# Bucket privado no Supabase Storage usado pela API para guardar fotos de comprovante.
DELIVERY_PROOF_STORAGE_BUCKET="delivery-proofs"
# Fallback local para desenvolvimento sem bucket.
DELIVERY_PROOF_STORAGE_DIR="./uploads/delivery-proofs"

# Supabase browser-safe keys. Use somente com RLS habilitado.
VITE_API_URL="http://localhost:3333"
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Firebase Web / Hosting. Use valores reais apenas nos .env locais, nunca neste exemplo.
VITE_FIREBASE_API_KEY="firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="firebase_web_app_id"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
# Chave publica Web Push certificates do Firebase Cloud Messaging para o PWA motoboy.
VITE_FIREBASE_WEB_PUSH_VAPID_KEY="firebase_web_push_vapid_public_key"

# Somente backend/ambiente seguro.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxx"
# Opcional: se preferir o nome legado aceito pela API.
# SUPABASE_SERVICE_ROLE_JWT="sb_secret_xxx"

# Firebase Admin SDK para envio FCM server-side.
# Use apenas no backend. Escolha uma das opcoes abaixo em ambiente seguro.
FIREBASE_PROJECT_ID="firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase_admin_client_email"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"..."}'
# FIREBASE_SERVICE_ACCOUNT_BASE64="base64_do_json_service_account"
# GOOGLE_APPLICATION_CREDENTIALS="C:\\caminho\\seguro\\service-account.json"

# Worker interno da API para avisar motoboys quando entrega agendada atingir earliestDispatchAt.
SCHEDULED_DELIVERY_NOTIFICATION_WORKER=true
SCHEDULED_DELIVERY_NOTIFICATION_INTERVAL_MS=60000
